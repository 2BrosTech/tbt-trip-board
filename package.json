{
  "name": "tbt-trip-board",
  "version": "1.0.0",
  "private": true,
  "description": "Free no-login trip board on Cloudflare Workers + KV, from Two Brothers Technology",
  "scripts": {
    "build": "esbuild src/app.jsx --bundle --minify --format=iife --loader:.jsx=jsx --jsx=automatic --outfile=public/app.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
